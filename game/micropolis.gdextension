[configuration]

entry_symbol = "micropolis_library_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]

macos.release = "res://bin/libmicropolis.macos.template_release.universal.dylib"
macos.debug.arm64 = "res://bin/libmicropolis.macos.template_debug.arm64.dylib"
macos.debug.x86_64 = "res://bin/libmicropolis.macos.template_debug.x86_64.dylib"
linux.debug.x86_64 = "res://bin/libmicropolis.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libmicropolis.linux.template_release.x86_64.so"
linux.debug.arm64 = "res://bin/libmicropolis.linux.template_debug.arm64.so"
linux.release.arm64 = "res://bin/libmicropolis.linux.template_release.arm64.so"
