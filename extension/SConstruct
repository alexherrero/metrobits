#!/usr/bin/env python
# Builds, with godot-cpp's toolchain settings:
#   engine    MicropolisCore's engine as a static library (build/)
#   smoke     a native smoke program over it (build/)
#   extension the GDExtension that wraps it for Godot (../game/bin/)
#   soak      the soak program (build/), and a second copy of it and the engine
#             built with clang's address and undefined-behaviour sanitizers
#             (build/micropolis_soak_san*), for .harness/soak.sh
# `scons` builds the first three and the plain soak program; name one to build
# only it, e.g. `scons smoke`. Only `scons soak` builds the sanitized copy.
# Options are godot-cpp's: platform=, target=, arch=, and so on.

import os
import platform

env = Environment(tools=["default"], PLATFORM="")
# godot-cpp defaults to a universal binary on macOS, which doubles the build.
# Default to the host's architecture instead; arch= on the command line wins.
if platform.system() == "Darwin":
    env["arch"] = platform.machine()
# Bind only the Godot classes our C++ uses; compiling all of godot-cpp takes
# minutes. Add a class here when the extension starts using it. Engine, OS and
# SceneTree are there because godot-cpp's own sources include them.
env["build_profile"] = File("build_profile.json").abspath
env = SConscript("godot-cpp/SConstruct", {"env": env, "api_version": "4.7"})

ENGINE_SRC = "../micropolis-core/engine"
# emscripten.cpp is the WebAssembly bindings (and pulls in js_callback.h).
# callback.cpp only defines the browser's ConsoleCallback, written in EM_ASM.
ENGINE_EXCLUDE = {"emscripten.cpp", "callback.cpp"}

# Keep objects out of the upstream tree.
VariantDir("build/engine", ENGINE_SRC, duplicate=False)
engine_sources = [
    "build/engine/" + name
    for name in sorted(os.listdir(Dir(ENGINE_SRC).srcnode().abspath))
    if name.endswith(".cpp") and name not in ENGINE_EXCLUDE
]

engine_env = env.Clone()
engine_env.Append(CPPPATH=[Dir(ENGINE_SRC)])
if engine_env["platform"] != "windows":
    # Upstream's code, built as is: don't drown our own warnings in its.
    engine_env.Append(CCFLAGS=["-w"])
engine = engine_env.StaticLibrary("build/libmicropolis" + env["suffix"] + env["LIBSUFFIX"], engine_sources)

smoke_env = engine_env.Clone(LIBS=[engine])
smoke_env.Append(CPPPATH=["native/"])
smoke = smoke_env.Program("build/micropolis_smoke" + env["suffix"], ["native/smoke.cpp"])
soak = smoke_env.Program("build/micropolis_soak" + env["suffix"], ["native/soak.cpp"])

# The engine and the soak again, with AddressSanitizer and
# UndefinedBehaviorSanitizer, in their own object folders. Undefined behaviour
# stops the program rather than printing and going on.
SANITIZE = ["-fsanitize=address,undefined", "-fno-sanitize-recover=undefined", "-fno-omit-frame-pointer"]
san_env = engine_env.Clone()
san_env.Append(CCFLAGS=SANITIZE, LINKFLAGS=SANITIZE)
VariantDir("build/engine-san", ENGINE_SRC, duplicate=False)
VariantDir("build/native-san", "native", duplicate=False)
san_engine = san_env.StaticLibrary(
    "build/libmicropolis-san" + env["suffix"] + env["LIBSUFFIX"],
    [source.replace("build/engine/", "build/engine-san/") for source in engine_sources],
)
san_soak_env = san_env.Clone(LIBS=[san_engine])
san_soak_env.Append(CPPPATH=["native/"])
soak_san = san_soak_env.Program("build/micropolis_soak_san" + env["suffix"], ["build/native-san/soak.cpp"])

ext_env = env.Clone()
ext_env.Append(CPPPATH=["src/", "native/", Dir(ENGINE_SRC)])
ext_env.Prepend(LIBS=[engine])
extension = ext_env.SharedLibrary(
    "../game/bin/libmicropolis{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
    Glob("src/*.cpp"),
)

env.Alias("engine", engine)
env.Alias("smoke", smoke)
env.Alias("extension", extension)
env.Alias("soak", [soak, soak_san])
Default(engine, smoke, extension, soak)
